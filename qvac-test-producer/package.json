{
	"name": "qvac-test-scheduler",
	"module": "batch-orchestrator.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"batch": "bun run batch-orchestrator.ts --allow-wildcard-consumers",
		"batch:transcription": "bun run batch-orchestrator.ts --section=transcription --allow-wildcard-consumers",
		"batch:completion": "bun run batch-orchestrator.ts --section=completion --allow-wildcard-consumers",
		"batch:embedding": "bun run batch-orchestrator.ts --section=embedding --allow-wildcard-consumers",
		"batch:rag": "bun run batch-orchestrator.ts --section=rag --allow-wildcard-consumers",
		"batch:model": "bun run batch-orchestrator.ts --section=model --allow-wildcard-consumers",
		"batch:translation": "bun run batch-orchestrator.ts --section=translation --allow-wildcard-consumers",
		"batch:tools": "bun run batch-orchestrator.ts --section=tools --allow-wildcard-consumers",
		"batch:cache": "bun run batch-orchestrator.ts --section=cache --allow-wildcard-consumers",
		"batch:error": "bun run batch-orchestrator.ts --section=error --allow-wildcard-consumers"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/node": "^24.5.2",
		"nodemon": "^3.1.10",
		"tsc-watch": "^7.1.1"
	},
	"peerDependencies": {
		"typescript": "^5.9.2"
	},
	"dependencies": {
		"mqtt": "^5.14.1",
		"zod": "^4.0.0"
	}
}
