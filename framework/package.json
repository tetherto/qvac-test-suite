{
    "name": "@tetherto/qvac-test-suite",
    "version": "0.1.0",
    "description": "Generic distributed testing framework for multi-platform execution",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "qvac-test": "./dist/cli/index.js"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "testing",
        "distributed",
        "mqtt",
        "multi-platform"
    ],
    "author": "Tether",
    "license": "UNLICENSED",
    "private": true,
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "dependencies": {
        "commander": "^14.0.2",
        "mqtt": "^5.14.1",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "typescript": "^5.3.3"
    }
}
